# Kavrix — environment variables (Stage 8).
# Copy to .env.local for development. Never commit real values.
# `/demo` needs none of these: without them the site builds and serves the demo,
# and the sign-in pages say that accounts are not configured.

# Supabase project URL and anon (public) key — Project Settings → API.
# Public by design: they ship to the browser, and Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER-SIDE ONLY: it bypasses RLS.
# Used by exactly one place, POST /api/ingest, after a connector token is verified.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Pepper for connector-token hashes (HMAC-SHA-256). At least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing it invalidates every connector token already issued.
CONNECTOR_TOKEN_PEPPER=

# This site's public origin, used in auth emails. Optional: without it the
# request's host is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
